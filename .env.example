NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your-publishable-key
CLERK_SECRET_KEY=your-secret-key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login # Replace with your login URL
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up # Replace with your signup URL
