DATABASE_URL=postgresql://user:password@localhost:6543/dbname?schema=public # Replace with your postgres connection URL
DIRECT_URL=postgresql://user:password@localhost:5432/dbname?schema=public # Replace with your postgres connection URL
SUPABASE_SERVICE_KEY=your-service-key
CLERK_WEBHOOK_SECRET=your-secret
CLOUDFLARE_WORKERS_AI_API_TOKEN=your-api-token
RESEND_API_KEY=your-api-key